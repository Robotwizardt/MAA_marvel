{
    "公共-详情关闭按钮": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    270,
                    1120,
                    180,
                    150
                ],
                "template": [
                    "common/battle/detail_close.png"
                ],
                "threshold": [
                    0.82
                ]
            }
        }
    },
    "公共-比赛开始": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MarvelRecordEvent",
                "custom_action_param": {
                    "event": "match_started"
                }
            }
