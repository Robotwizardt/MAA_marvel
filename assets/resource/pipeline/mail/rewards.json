    "邮箱-领取后状态": {
        "next": [
            "邮箱-奖励展示领取",
            "邮箱-已领取详情关闭"
        ],
        "rate_limit": 500,
        "timeout": 15000,
        "on_error": [
            "公共-安全停止"
        ]
    },
    "邮箱-关闭文本": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    120,
                    950,
                    160,
                    100
                ],
                "expected": [
                    "^关闭$"
                ]
            }
        }
    },
    "邮箱-已领取详情关闭": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "邮箱-已领取状态",
                    "邮箱-关闭文本"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 700,
        "next": [
            "邮箱-收件箱状态"
        ],
        "on_error": [
            "公共-安全停止"
        ]
    },
    "邮箱-收件箱关闭": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "邮箱-收件箱页面",
                    "邮箱-关闭文本"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "邮箱-首页确认"
        ],
        "on_error": [
            "公共-安全停止"
        ]
    },
    "邮箱-首页确认": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "公共-首页开战按钮",
                    "公共-首页标签"
                ],
                "box_index": 0
            }
        },
        "next": [
            "日常-邮箱完成路由",
            "日常-普通子任务完成"
        ],
        "timeout": 10000,
        "on_error": [
            "公共-安全停止"
        ]
    }
}
