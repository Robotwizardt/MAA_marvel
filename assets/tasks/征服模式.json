{
    "task": [
        {
            "name": "征服模式自动对战",
            "entry": "征服-任务入口",
            "default_check": true,
            "resource": [
                "官服"
            ],
            "controller": [
                "安卓端"
            ],
            "description": "仅支持国服安卓端 1920×1080 横屏；不会购买门票或消耗金块。",
            "option": [
                "征服-选择卡组",
                "征服-出牌策略",
                "征服-放牌场地顺序",
                "征服-最高档位",
                "征服-保留门票数",
                "征服-每日经验上限后结束",
                "征服-自动撤退",
                "征服-领取任务奖励小时",
                "征服-匹配超时",
                "征服-自动重启"
            ]
        },
        {
            "name": "天梯模式自动对战",
            "entry": "天梯-任务入口",
            "default_check": false,
            "resource": [
                "官服"
            ],
            "controller": [
                "安卓端"
            ],
            "description": "从主页关闭训练模式后进入天梯匹配，复用 OCR/阿加莎出牌、SNAP、撤退和停止条件。",
            "option": [
                "征服-出牌策略",
                "征服-放牌场地顺序",
                "征服-每日经验上限后结束",
                "征服-自动撤退",
                "征服-领取任务奖励小时",
                "征服-匹配超时",
                "征服-自动重启"
            ]
        },
        {
            "name": "训练模式-OCR选牌测试（单回合）",
            "entry": "训练-OCR选牌测试入口",
            "default_check": false,
            "resource": [
                "官服"
            ],
            "controller": [
                "安卓端"
            ],
            "description": "请先手动进入训练模式并停在我方回合；反复选择当前能量可支付的最高费用牌，直到无牌可出后结束回合。",
            "option": [
                "征服-放牌场地顺序"
            ]
        },
        {
            "name": "领取邮箱奖励",
            "entry": "邮箱-任务入口",
            "default_check": false,
            "resource": [
                "官服"
            ],
            "controller": [
                "安卓端"
            ],
            "description": "从主界面或已打开的收件箱开始，仅领取带红点邮件中的可领取奖励；没有红点时直接完成。",
            "option": []
        },
        {
            "name": "一键日常任务",
            "entry": "日常-任务入口",
            "default_check": false,
            "resource": [
                "官服"
            ],
            "controller": [
                "安卓端"
            ],
            "description": "依次处理启动弹窗、累计签到、每日任务奖励、邮箱奖励和通行证可领取奖励，确认返回主页后进入配置的对战模式。不会购买通行证或消耗货币。",
            "option": [
                "日常-完成后模式",
                "征服-选择卡组",
                "征服-出牌策略",
                "征服-放牌场地顺序",
                "征服-最高档位",
                "征服-保留门票数",
                "征服-每日经验上限后结束",
                "征服-自动撤退",
                "征服-领取任务奖励小时",
                "征服-匹配超时",
                "征服-自动重启"
            ]
        }
    ],
    "option": {
        "日常-完成后模式": {
            "type": "select",
            "label": "日常完成后进入",
            "description": "全部日常步骤完成并返回主页后，进入所选模式持续自动对战。",
            "default_case": "conquest",
            "cases": [
                {
                    "name": "conquest",
                    "label": "征服模式",
                    "pipeline_override": {
                        "Config_DailyBattleMode": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "game_mode": "conquest"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "ladder",
                    "label": "天梯模式",
                    "pipeline_override": {
                        "Config_DailyBattleMode": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "game_mode": "ladder"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "征服-选择卡组": {
            "type": "input",
            "label": "选择卡组",
            "description": "填写 0 表示不选择卡组；填写完整卡组名称后，在赛前页面选择同名卡组；留空或未找到时继续使用当前卡组。",
            "inputs": [
                {
                    "name": "卡组名称",
                    "label": "卡组名称",
                    "default": "0",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "Config_DeckName": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "deck_name": "{卡组名称}"
                            }
                        }
                    }
                },
                "征服-选择指定卡组": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "^(?!0$){卡组名称}$"
                            ]
                        }
                    }
                },
                "征服-验证指定卡组": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "^(?!0$){卡组名称}$"
                            ]
                        }
                    }
                }
            }
        },
        "征服-出牌策略": {
            "type": "select",
            "label": "出牌策略",
            "default_case": "ocr",
            "cases": [
                {
                    "name": "agatha",
                    "label": "阿加莎托管",
                    "pipeline_override": {
                        "Config_PlayStrategy": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "play_strategy": "agatha"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "ocr",
                    "label": "OCR 智能选牌",
                    "description": "识别当前能量和全部手牌，优先打出可支付的最高费用牌。",
                    "pipeline_override": {
                        "Config_PlayStrategy": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "play_strategy": "ocr"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "征服-放牌场地顺序": {
            "type": "select",
            "label": "放牌场地顺序",
            "description": "决定一张牌优先尝试放入左、中、右哪个场地；场地已满时会继续尝试下一个。",
            "default_case": "left_to_right",
            "cases": [
                {
                    "name": "random",
                    "label": "每张牌随机",
                    "pipeline_override": {
                        "Config_LaneOrder": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "lane_order": "random"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "left_to_right",
                    "label": "从左往右",
                    "pipeline_override": {
                        "Config_LaneOrder": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "lane_order": "left_to_right"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "right_to_left",
                    "label": "从右往左",
                    "pipeline_override": {
                        "Config_LaneOrder": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "lane_order": "right_to_left"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "征服-最高档位": {
            "type": "select",
            "label": "最高征服档位",
            "description": "从该档位向下寻找已有门票；绝不使用金块购买入口。",
            "default_case": "proving_grounds",
            "cases": [
                {
                    "name": "proving_grounds",
                    "label": "试炼之地",
                    "pipeline_override": {
                        "Config_MaxTier": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "max_tier": "proving_grounds"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "silver",
                    "label": "白银征服",
                    "pipeline_override": {
                        "Config_MaxTier": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "max_tier": "silver"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "gold",
                    "label": "黄金征服",
                    "pipeline_override": {
                        "Config_MaxTier": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "max_tier": "gold"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "infinite",
                    "label": "无限征服",
                    "pipeline_override": {
                        "Config_MaxTier": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "max_tier": "infinite"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "征服-保留门票数": {
            "type": "input",
            "label": "保留门票数",
            "description": "只有当前门票数严格大于保留数时才进入该档位，否则自动回退一级。",
            "inputs": [
                {
                    "name": "保留白银门票",
                    "label": "白银门票",
                    "default": "10",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]*)$",
                    "pattern_msg": "请输入非负整数"
                },
                {
                    "name": "保留黄金门票",
                    "label": "黄金门票",
                    "default": "10",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]*)$",
                    "pattern_msg": "请输入非负整数"
                },
                {
                    "name": "保留无限门票",
                    "label": "无限门票",
                    "default": "99",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]*)$",
                    "pattern_msg": "请输入非负整数"
                }
            ],
            "pipeline_override": {
                "Config_ReserveTickets": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "reserve_silver_tickets": "{保留白银门票}",
                                "reserve_gold_tickets": "{保留黄金门票}",
                                "reserve_infinite_tickets": "{保留无限门票}"
                            }
                        }
                    }
                }
            }
        },
        "征服-每日经验上限后结束": {
            "type": "switch",
            "label": "达到每日通行证经验上限后结束",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "结束任务",
                    "pipeline_override": {
                        "Config_StopDailyPass": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "stop_on_daily_pass_limit": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "继续对战",
                    "pipeline_override": {
                        "Config_StopDailyPass": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "stop_on_daily_pass_limit": false
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "征服-自动撤退": {
            "type": "select",
            "label": "自动撤退",
            "description": "选择完成第 N 回合后撤退时，会在第 N+1 回合开始执行。",
            "default_case": "off",
            "cases": [
                {
                    "name": "off",
                    "label": "关闭",
                    "pipeline_override": {
                        "Config_Retreat": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "retreat_after_turn": 0
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "turn_4",
                    "label": "完成第 4 回合后",
                    "pipeline_override": {
                        "Config_Retreat": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "retreat_after_turn": 4
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "turn_5",
                    "label": "完成第 5 回合后",
                    "pipeline_override": {
                        "Config_Retreat": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "retreat_after_turn": 5
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "turn_6",
                    "label": "完成第 6 回合后",
                    "pipeline_override": {
                        "Config_Retreat": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "retreat_after_turn": 6
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "征服-领取任务奖励小时": {
            "type": "input",
            "label": "领取任务奖励小时",
            "description": "每隔指定小时，等待当前整场结束，再回到主页领取已完成的每日任务奖励；0 表示关闭。",
            "inputs": [
                {
                    "name": "领取任务奖励小时",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]*)$",
                    "pattern_msg": "请输入非负整数"
                }
            ],
            "pipeline_override": {
                "Config_ClaimTaskRewardsHours": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "claim_task_rewards_hours": "{领取任务奖励小时}"
                            }
                        }
                    }
                }
            }
        },
        "征服-匹配超时": {
            "type": "input",
            "label": "匹配超时（秒）",
            "inputs": [
                {
                    "name": "匹配超时",
                    "default": "600",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请输入正整数秒数"
                }
            ],
            "pipeline_override": {
                "Config_MatchmakingTimeout": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "matchmaking_timeout_seconds": "{匹配超时}"
                            }
                        }
                    }
                }
            }
        },
        "征服-自动重启": {
            "type": "switch",
            "label": "异常时自动重启游戏",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "Config_AutoRestart": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "auto_restart": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Config_AutoRestart": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "auto_restart": false
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
